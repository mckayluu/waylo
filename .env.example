# ── AI ─────────────────────────────────────────────
# Optional. Without it Waylo uses the built-in mock responder (still grounded + streamed).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Admin auth ─────────────────────────────────────
# Set to lock /admin and admin APIs. Unset = open admin with a warning banner.
WAYLO_ADMIN_PASSWORD=
# Optional: require this email for the owner login (otherwise password alone).
WAYLO_ADMIN_EMAIL=
# Optional: separate secret for signing session cookies (defaults to the password; changing either signs everyone out).
WAYLO_SESSION_SECRET=

# ── Hosting ────────────────────────────────────────
# Public base URL (used in invite links and Slack/CRM notification links).
# Production: https://waylo-j5hv.onrender.com (defaults to that when NODE_ENV=production and unset).
WAYLO_PUBLIC_URL=http://localhost:3000
# JSON data file. Must be on a persistent, writable disk in production.
WAYLO_DATA_FILE=./data/db.json

# ── Database ───────────────────────────────────────
# Postgres connection string (Supabase/Neon/Railway). Set = Postgres store; unset = JSON file below. Run `npm run db:migrate` after setting.
DATABASE_URL=

# ── Security ───────────────────────────────────────
# Comma-separated origins allowed to call public APIs (chat, track, feedback, handoff, leads) from an embed.
# Same-site and requests with no Origin are always allowed. Unset (and empty in Settings) = any origin.
WAYLO_ALLOWED_ORIGINS=

# ── Email (invites + password reset) ───────────────
# Resend API key (resend.com, free tier). Unset = links are logged server-side and admin shows "copy link".
RESEND_API_KEY=
# Sender. onboarding@resend.dev only delivers to your own Resend account email — verify a domain for real use.
WAYLO_FROM_EMAIL=Waylo <onboarding@resend.dev>

# ── Billing (Stripe) ───────────────────────────────
# Unset = billing disabled (pricing CTAs show "not configured", publishing not gated).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at <WAYLO_PUBLIC_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional price overrides (otherwise resolved by lookup_key waylo_{trial,starter,growth}_monthly)
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
